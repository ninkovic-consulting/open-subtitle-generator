# OpenRouter API key (https://openrouter.ai/keys). Optional: you can also paste it in Settings.
# OPEN_ROUTER_API is accepted as an alias.
OPENROUTER_API_KEY=

# Port for the local web UI (always bound to 127.0.0.1)
PORT=4747

# Override the data folder (SQLite DB + temp files). Defaults to the OS app-data folder.
# OSG_DATA_DIR=

# Set to 0 to stop `npm start` from opening the browser
# OPEN_BROWSER=1
